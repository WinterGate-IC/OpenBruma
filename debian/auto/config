#!/bin/sh
# live-build configuration for OpenBruma (Debian edition)
set -e

lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --linux-flavours amd64 \
  --linux-packages "linux-image" \
  --bootloaders "syslinux,grub-efi" \
  --debian-installer false \
  --bootappend-live "boot=live components quiet splash username=openbruma hostname=openbruma" \
  --bootappend-live-failsafe "boot=live components memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=normal" \
  --iso-application "OpenBruma OSINT Edition" \
  --iso-publisher "WinterGate Intelligence Collective <https://wintergate.org>" \
  --iso-volume "OPENBRUMA" \
  --image-name "openbruma" \
  --mirror-bootstrap "http://deb.debian.org/debian" \
  --mirror-chroot "http://deb.debian.org/debian" \
  --mirror-binary "http://deb.debian.org/debian" \
  --mirror-chroot-security "http://security.debian.org/debian-security" \
  --mirror-binary-security "http://security.debian.org/debian-security" \
  --apt-options "--yes --no-install-recommends" \
  --keyring-packages "debian-archive-keyring"
