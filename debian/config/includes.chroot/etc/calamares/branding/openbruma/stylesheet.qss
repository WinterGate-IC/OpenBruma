/* OpenBruma Calamares stylesheet — WIC neo-noir.
   Keep this targeted: styling every QWidget painted a black rectangle over
   embedded QML pages. */

QMainWindow, QDialog, #mainApp {
    background-color: #0a0c0f;
    color: #dcecff;
    font-family: "Inter", "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

QLabel {
    color: #dcecff;
    background: transparent;
}

QPushButton {
    background-color: #0f1a1a;
    color: #eafff5;
    border: 1px solid #00ff9d;
    border-radius: 5px;
    padding: 6px 16px;
}
QPushButton:hover { background-color: #123328; }
QPushButton:pressed { background-color: #00ff9d; color: #0a0c0f; }
QPushButton:disabled { color: #4d5a66; border-color: #1d2a33; }

QLineEdit, QComboBox, QSpinBox, QTextEdit, QListWidget, QTreeWidget {
    background-color: #0f1418;
    color: #eafff5;
    border: 1px solid #1b4a3a;
    selection-background-color: #00ff9d;
    selection-color: #0a0c0f;
}

QComboBox QAbstractItemView {
    background-color: #0f1418;
    color: #eafff5;
    selection-background-color: #00ff9d;
    selection-color: #0a0c0f;
}

QProgressBar {
    background-color: #0f1418;
    border: 1px solid #1b4a3a;
    border-radius: 4px;
    text-align: center;
    color: #eafff5;
}
QProgressBar::chunk {
    background-color: #00ff9d;
    border-radius: 3px;
}

QScrollBar:vertical { background: #0a0c0f; width: 12px; }
QScrollBar::handle:vertical { background: #1b4a3a; border-radius: 6px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QGroupBox { border: 1px solid #1b4a3a; border-radius: 6px; margin-top: 8px; }
QGroupBox::title { color: #00ff9d; subcontrol-origin: margin; left: 10px; padding: 0 4px; }

QCheckBox::indicator:checked { background-color: #00ff9d; border: 1px solid #00ff9d; }
QCheckBox::indicator:unchecked { background-color: #0f1418; border: 1px solid #1b4a3a; }
