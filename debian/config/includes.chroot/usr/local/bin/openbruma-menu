#!/usr/bin/env python3
"""OpenBruma application menu.

A small, fully themed GTK3 launcher that replaces Whisker. Categories:
Favorites, OSINT & Investigation, OPSEC, WIC Apps and the standard desktop
groups. Loads its own CSS and is deliberately defensive: a broken .desktop
file, missing icon or failed CSS load must never take the menu down.
"""
import os
import signal
import sys
import traceback

try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gio, GLib, Gtk
except Exception:  # pragma: no cover - only when GTK is missing
    sys.stderr.write("OpenBruma menu requires python3-gi and GTK3\n")
    sys.exit(1)

APP_DIRS = [
    os.path.expanduser("~/.local/share/applications"),
    "/usr/local/share/applications",
    "/usr/share/applications",
]

CATEGORIES = [
    ("favorites", "Favorites", "emblem-favorite"),
    ("osint", "OSINT & Investigation", "system-search"),
    ("opsec", "OPSEC", "security-high"),
    ("wic", "WIC Apps", "wic-official"),
    ("internet", "Internet", "applications-internet"),
    ("graphics", "Graphics", "applications-graphics"),
    ("multimedia", "Multimedia", "applications-multimedia"),
    ("office", "Office", "applications-office"),
    ("system", "System", "applications-system"),
    ("settings", "Settings", "preferences-system"),
    ("all", "All Applications", "applications-other"),
]

FAVORITES = [
    "firefox-esr.desktop",
    "xfce4-terminal.desktop",
    "thunar.desktop",
    "openbruma-installer-guided.desktop",
    "openbruma-themes.desktop",
    "openbruma-torbrowser.desktop",
    "openbruma-about.desktop",
]

HIDDEN = {
    "openbruma-menu.desktop",
    "openbruma-glow-on.desktop",
    "openbruma-glow-off.desktop",
    "calamares.desktop",
}

PIDFILE = os.path.join(GLib.get_user_runtime_dir(), "openbruma-menu.pid")
CSS_CANDIDATES = [
    os.path.expanduser("~/.config/openbruma/menu.css"),
    "/usr/share/openbruma/themes/menu.css",
]


def log(msg):
    try:
        with open("/tmp/openbruma-menu.log", "a", encoding="utf-8") as fh:
            fh.write(msg + "\n")
    except OSError:
        pass


def key_bool(key, group, name, default=False):
    try:
        return key.get_boolean(group, name)
    except GLib.Error:
        return default


def load_apps():
    apps = {}
    for directory in APP_DIRS:
        if not os.path.isdir(directory):
            continue
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".desktop") or name in HIDDEN:
                continue
            if name in apps:
                continue
            path = os.path.join(directory, name)
            key = GLib.KeyFile()
            try:
                key.load_from_file(path, GLib.KeyFileFlags.NONE)
            except GLib.Error:
                continue
            if key_bool(key, "Desktop Entry", "NoDisplay"):
                continue
            if key_bool(key, "Desktop Entry", "Hidden"):
                continue
            try:
                title = key.get_locale_string("Desktop Entry", "Name", None)
            except GLib.Error:
                continue
            if not title:
                continue
            try:
                comment = key.get_locale_string("Desktop Entry", "Comment", None) or ""
            except GLib.Error:
                comment = ""
            try:
                icon = key.get_string("Desktop Entry", "Icon") or "application-x-executable"
            except GLib.Error:
                icon = "application-x-executable"
            try:
                cats = key.get_string_list("Desktop Entry", "Categories")
            except GLib.Error:
                cats = []
            apps[name] = {
                "file": name,
                "path": path,
                "name": title,
                "comment": comment,
                "icon": icon,
                "categories": cats,
                "search": (title + " " + comment + " " + name).lower(),
            }
    return apps


def category_apps(apps, cat):
    items = []
    for app in apps.values():
        cats = app["categories"]
        if cat == "favorites":
            if app["file"] in FAVORITES:
                items.append(app)
        elif cat == "osint":
            if "X-OSINT" in cats:
                items.append(app)
        elif cat == "opsec":
            if "X-OPSEC" in cats:
                items.append(app)
        elif cat == "wic":
            if "WIC" in cats:
                items.append(app)
        elif cat == "internet":
            if "Network" in cats or "Internet" in cats:
                items.append(app)
        elif cat == "graphics":
            if "Graphics" in cats:
                items.append(app)
        elif cat == "multimedia":
            if "AudioVideo" in cats:
                items.append(app)
        elif cat == "office":
            if "Office" in cats:
                items.append(app)
        elif cat == "system":
            if "System" in cats and "Settings" not in cats:
                items.append(app)
        elif cat == "settings":
            if "Settings" in cats:
                items.append(app)
        else:
            items.append(app)
    items.sort(key=lambda a: a["name"].lower())
    return items


def launch(app):
    try:
        info = Gio.DesktopAppInfo.new_from_filename(app["path"])
        if info is not None:
            info.launch([], None)
            return True
    except Exception:
        log("launch failed: %s\n%s" % (app.get("path"), traceback.format_exc()))
    try:
        GLib.spawn_command_line_async("gtk-launch " + app["file"])
        return True
    except Exception:
        log("gtk-launch failed for %s" % app.get("file"))
    return False


class Menu(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("openbruma-menu")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)
        self.set_default_size(780, 560)

        css = Gtk.CssProvider()
        for path in CSS_CANDIDATES:
            if not os.path.exists(path):
                continue
            try:
                css.load_from_path(path)
                Gtk.StyleContext.add_provider_for_screen(
                    Gdk.Screen.get_default(), css,
                    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
                break
            except Exception:
                log("css load failed: %s\n%s" % (path, traceback.format_exc()))

        self.apps = load_apps()
        log("loaded %d applications" % len(self.apps))

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.set_border_width(10)
        self.add(outer)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        logo = Gtk.Image.new_from_icon_name("openbruma-logo", Gtk.IconSize.DND)
        title = Gtk.Label(label="OpenBruma")
        title.set_name("menu-title")
        header.pack_start(logo, False, False, 0)
        header.pack_start(title, False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search applications…")
        self.search.connect("changed", self.on_search)
        self.search.connect("key-press-event", self.on_search_key)
        header.pack_start(self.search, True, True, 8)
        outer.pack_start(header, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        outer.pack_start(body, True, True, 0)

        self.cat_list = Gtk.ListBox()
        self.cat_list.set_name("menu-categories")
        self.cat_list.connect("row-selected", self.on_category)
        for cid, label, icon in CATEGORIES:
            row = Gtk.ListBoxRow()
            row.cat_id = cid
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
            box.pack_start(img, False, False, 0)
            lbl = Gtk.Label(label=label, xalign=0)
            box.pack_start(lbl, True, True, 0)
            row.add(box)
            self.cat_list.add(row)
        cat_scroll = Gtk.ScrolledWindow()
        cat_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        cat_scroll.set_size_request(245, -1)
        cat_scroll.add(self.cat_list)
        body.pack_start(cat_scroll, False, False, 0)

        self.app_list = Gtk.ListBox()
        self.app_list.set_name("menu-apps")
        self.app_list.connect("row-activated", self.on_launch)
        self.app_list.connect("key-press-event", self.on_app_key)
        app_scroll = Gtk.ScrolledWindow()
        app_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        app_scroll.add(self.app_list)
        body.pack_start(app_scroll, True, True, 0)

        self.footer = Gtk.Label(label="Type to search · Enter to launch · Esc to close")
        self.footer.set_name("menu-footer")
        outer.pack_start(self.footer, False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("destroy", lambda *_: Gtk.main_quit())
        self._had_focus = False
        self.connect("focus-in-event", self.on_focus_in)
        self.show_all()
        self.place()
        self.set_accept_focus(True)
        GLib.idle_add(self.grab_keyboard_focus)
        self.cat_list.select_row(self.cat_list.get_row_at_index(0))

    def grab_keyboard_focus(self):
        try:
            self.present()
            win = self.get_window()
            if win is not None:
                win.focus(Gdk.CURRENT_TIME)
            self.search.grab_focus()
        except Exception:
            log("focus failed\n" + traceback.format_exc())
        return False

    def on_focus_in(self, *_args):
        self._had_focus = True
        return False

    def on_focus_out(self, *_args):
        if self._had_focus:
            Gtk.main_quit()
        return False

    def enable_focus_close(self):
        try:
            self.connect("focus-out-event", lambda *_: Gtk.main_quit())
        except Exception:
            pass
        return False

    def place(self):
        try:
            display = Gdk.Display.get_default()
            monitor = display.get_primary_monitor() or display.get_monitor(0)
            geo = monitor.get_geometry()
            width = min(780, max(520, geo.width - 16))
            height = min(600, max(360, geo.height - 60))
            self.resize(width, height)
            self.move(geo.x + 8, geo.y + 44)
        except Exception:
            log("place failed\n" + traceback.format_exc())

    def clear_apps(self):
        for row in self.app_list.get_children():
            self.app_list.remove(row)

    def fill(self, apps):
        self.clear_apps()
        if not apps:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label="No applications in this category")
            lbl.set_name("menu-empty")
            row.add(lbl)
            self.app_list.add(row)
            self.app_list.show_all()
            return
        for app in apps:
            row = Gtk.ListBoxRow()
            row.app = app
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            img = Gtk.Image.new_from_icon_name(app["icon"], Gtk.IconSize.DND)
            box.pack_start(img, False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            name = Gtk.Label(label=app["name"], xalign=0)
            name.set_name("app-title")
            name.set_ellipsize(3)  # Pango.EllipsizeMode.END
            comment = Gtk.Label(label=app["comment"], xalign=0)
            comment.set_name("app-comment")
            comment.set_ellipsize(3)
            text.pack_start(name, False, False, 0)
            text.pack_start(comment, False, False, 0)
            box.pack_start(text, True, True, 0)
            row.add(box)
            self.app_list.add(row)
        self.app_list.show_all()
        first = self.app_list.get_row_at_index(0)
        if first:
            self.app_list.select_row(first)

    def on_category(self, _list, row):
        if row is None:
            return
        self.search.set_text("")
        self.fill(category_apps(self.apps, row.cat_id))

    def on_search(self, entry):
        text = entry.get_text().strip().lower()
        if not text:
            row = self.cat_list.get_selected_row()
            if row is not None:
                self.fill(category_apps(self.apps, row.cat_id))
            return
        self.fill([a for a in self.apps.values() if text in a["search"]])

    def on_launch(self, _list, row):
        app = getattr(row, "app", None)
        if app and launch(app):
            Gtk.main_quit()

    def focus_apps(self):
        row = self.app_list.get_selected_row()
        if row is None:
            row = self.app_list.get_row_at_index(0)
        if row is not None:
            self.app_list.select_row(row)
            row.grab_focus()
            return True
        return False

    def on_search_key(self, _widget, event):
        if event.keyval in (Gdk.KEY_Down, Gdk.KEY_Tab):
            self.focus_apps()
            return True
        return False

    def on_app_key(self, _widget, event):
        if event.keyval == Gdk.KEY_BackSpace:
            self.search.grab_focus()
            return True
        return False

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            row = self.app_list.get_selected_row()
            if row is not None and getattr(row, "app", None):
                self.on_launch(self.app_list, row)
                return True
        return False


def already_running():
    try:
        with open(PIDFILE, "r", encoding="utf-8") as fh:
            pid = int(fh.read().strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        return None


def main():
    running = already_running()
    if running:
        # Second click on the menu button toggles it closed.
        try:
            os.kill(running, signal.SIGTERM)
        except OSError:
            pass
        return
    try:
        with open(PIDFILE, "w", encoding="utf-8") as fh:
            fh.write(str(os.getpid()))
    except OSError:
        pass

    def cleanup(*_args):
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    try:
        Gtk.init(sys.argv)
        Menu()
        Gtk.main()
    except Exception:
        log("fatal\n" + traceback.format_exc())
        sys.exit(1)
    finally:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


if __name__ == "__main__":
    main()
