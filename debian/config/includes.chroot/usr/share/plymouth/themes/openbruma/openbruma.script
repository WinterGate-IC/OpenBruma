# OpenBruma Plymouth script theme

wallpaper_image = Image("background.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
resized_wallpaper = wallpaper_image.Scale(screen_width, screen_height);
wallpaper_sprite = Sprite(resized_wallpaper);
wallpaper_sprite.SetZ(-100);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
logo_sprite.SetZ(10);

message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() * 0.78, 10000);

fun message_callback(text) {
    message_sprite.SetText(text, "DejaVu Sans 14", 0.85, 0.92, 1.0);
}

Plymouth.SetMessageFunction(message_callback);

fun boot_progress_callback(duration, progress) {
    # reserved for future progress bar
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
