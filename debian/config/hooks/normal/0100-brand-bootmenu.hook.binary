#!/bin/sh
# Brand the boot menus and splash images of the built ISO.
# live-build runs this hook from inside the 'binary' directory.
set -e

for f in boot/grub/grub.cfg \
         boot/grub/loopback.cfg \
         isolinux/live.cfg \
         isolinux/menu.cfg \
         isolinux/stdmenu.cfg; do
  if [ -f "$f" ]; then
    sed -i \
      -e 's/Live system/OpenBruma Live/g' \
      -e 's/Boot menu/OpenBruma Boot Menu/g' \
      -e 's/^menu title .*/menu title OpenBruma Boot Menu/' \
      "$f" || true
  fi
done

# Replace the auto-generated Debian splash images with our branded art.
if [ -f ../config/bootloaders/syslinux_common/splash.png ]; then
  cp -f ../config/bootloaders/syslinux_common/splash.png isolinux/splash.png
fi
if [ -f ../config/bootloaders/grub-pc/live-theme/background.png ]; then
  cp -f ../config/bootloaders/grub-pc/live-theme/background.png boot/grub/splash.png
fi

# Auto-boot after 5 seconds (syslinux uses tenths of a second).
if [ -f isolinux/isolinux.cfg ]; then
  sed -i 's/^timeout .*/timeout 30/' isolinux/isolinux.cfg || true
fi
if [ -f boot/grub/config.cfg ]; then
  grep -q '^set timeout=' boot/grub/config.cfg && sed -i 's/^set timeout=.*/set timeout=3/' boot/grub/config.cfg || echo 'set timeout=3' >> boot/grub/config.cfg
fi

echo "OpenBruma boot menu branding applied"
