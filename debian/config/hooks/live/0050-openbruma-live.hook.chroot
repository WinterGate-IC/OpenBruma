#!/bin/sh
# OpenBruma live session setup (runs in chroot during build)
set -e

# Hostname / branding
echo "openbruma" > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1 localhost
127.0.1.1 openbruma
::1       localhost
EOF

cat > /etc/os-release <<'EOF'
NAME="OpenBruma"
PRETTY_NAME="OpenBruma OSINT Edition 0.4"
ID=openbruma
ID_LIKE=debian
VERSION_ID="0.4"
VERSION="0.4 (trixie)"
VERSION_CODENAME=trixie
HOME_URL="https://github.com/WinterGate-IC/OpenBruma"
SUPPORT_URL="https://github.com/WinterGate-IC/OpenBruma/issues"
BUG_REPORT_URL="https://github.com/WinterGate-IC/OpenBruma/issues"
EOF
ln -sf ../usr/lib/os-release /etc/lsb-release 2>/dev/null || true

# Live user is baked into the image so the documented credentials and the
# pre-seeded home work offline. Calamares forbids reusing this name on install
# (users.conf forbiddenLoginNames) and the install cleanup removes it.
if ! id openbruma >/dev/null 2>&1; then
  useradd -m -G sudo,audio,video,netdev -s /bin/bash openbruma || true
fi
echo "openbruma:openbruma" | chpasswd || true
# Documented live/root credentials: root / openbruma
echo "root:openbruma" | chpasswd || true

# Passwordless sudo for live user
mkdir -p /etc/sudoers.d
echo "openbruma ALL=(ALL:ALL) NOPASSWD:ALL" > /etc/sudoers.d/openbruma
chmod 440 /etc/sudoers.d/openbruma

# Let the live user start Calamares through pkexec without an extra prompt.
mkdir -p /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/49-openbruma-live.rules <<'EOF'
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.policykit.exec" &&
      subject.user == "openbruma") {
    return polkit.Result.YES;
  }
});
EOF

# Autologin (lightdm) and XFCE session
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-openbruma-autologin.conf <<'EOF'
[Seat:*]
autologin-user=openbruma
autologin-user-timeout=0
user-session=xfce
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
greeter-show-manual-login=true
allow-user-switching=true
EOF

# Enable services
systemctl enable NetworkManager || true
systemctl enable lightdm || true
systemctl enable bluetooth || true

# Boot speed: services that are irrelevant on a live/OSINT desktop add
# seconds of startup time. Masking them is safe (they stay installed).
for unit in ModemManager.service cups.service cups-browsed.service \
            avahi-daemon.service avahi-daemon.socket saned.socket \
            speech-dispatcher.service colord.service; do
  systemctl mask "$unit" >/dev/null 2>&1 || true
done

# The picom package ships its own autostart entry. Running it next to xfwm's
# compositor causes black/flickering repaints on VMs, so the glow is opt-in.
rm -f /etc/xdg/autostart/picom.desktop
systemctl enable earlyoom || true
systemctl enable preload || true
systemctl enable tuned || true
systemctl enable irqbalance || true

# NetworkManager owns every interface (wifi included), with stable wifi
# behaviour for laptop cards.
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/00-openbruma.conf <<'EOF'
[main]
plugins=ifupdown,keyfile
[ifupdown]
managed=true
[device]
wifi.scan-rand-mac-address=no
[connection]
wifi.powersave=2
EOF
cat > /etc/network/interfaces <<'EOF'
# Managed by NetworkManager.
auto lo
iface lo inet loopback
EOF
mkdir -p /etc/NetworkManager/system-connections
chmod 700 /etc/NetworkManager/system-connections
# Unblock radios on boot (rfkill soft blocks survive some firmware resets).
cat > /usr/local/bin/openbruma-unblock-radios <<'EOF'
#!/bin/sh
rfkill unblock all 2>/dev/null || true
EOF
chmod 0755 /usr/local/bin/openbruma-unblock-radios
cat > /etc/xdg/autostart/openbruma-radios.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=OpenBruma Radios
Exec=/usr/local/bin/openbruma-unblock-radios
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
OnlyShowIn=XFCE;
EOF

# XFCE defaults live in /etc/skel via includes.chroot.

# Qt applications (Calamares, AnonSurf GUI) should render dark out of the box.
if ! grep -q '^QT_STYLE_OVERRIDE=' /etc/environment 2>/dev/null; then
  echo 'QT_STYLE_OVERRIDE=Adwaita-Dark' >>/etc/environment
fi

# Calamares launchers: Guided (erase disk) and Custom (manual partitioning).
# Calamares 3.3 needs a full application-data directory (qml/) when -c is used,
# so instead of a second config tree we swap one partition profile and run the
# stock /etc/calamares tree. The wrappers run as root via pkexec.
mkdir -p /etc/skel/Desktop /usr/share/applications \
         /usr/share/openbruma/calamares /usr/local/bin

cat > /usr/share/openbruma/calamares/partition-guided.conf <<'EOF'
---
initialPartitioningChoice: eraseDisk
initialSwapChoice: none
defaultFileSystemType: ext4
efiSystemPartition: /boot/efi
drawNestedPartitions: false
alwaysShowPartitionLabels: true
EOF

cat > /usr/share/openbruma/calamares/partition-custom.conf <<'EOF'
---
initialPartitioningChoice: manual
defaultFileSystemType: ext4
efiSystemPartition: /boot/efi
drawNestedPartitions: true
alwaysShowPartitionLabels: true
EOF

cat > /usr/share/openbruma/calamares/partition-removable.conf <<'EOF'
---
initialPartitioningChoice: eraseDisk
initialSwapChoice: none
defaultFileSystemType: ext4
efiSystemPartition: /boot/efi
drawNestedPartitions: false
alwaysShowPartitionLabels: true
EOF

# The installer launchers live in config/includes.chroot/usr/local/bin and are
# installed after the packages; writing them here would overwrite the versions
# that enforce branding + the software QML backend at runtime.

cat > /usr/share/applications/openbruma-installer-guided.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install OpenBruma (Guided)
Comment=Guided install: erase the selected disk and install OpenBruma
Exec=pkexec /usr/local/bin/openbruma-install-guided
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
EOF

cat > /usr/share/applications/openbruma-installer-custom.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install OpenBruma (Custom)
Comment=Custom install: manual partitioning and advanced options
Exec=pkexec /usr/local/bin/openbruma-install-custom
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
EOF

cat > /usr/share/applications/openbruma-installer-removable.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install OpenBruma (USB / Virtual Machine)
Comment=Guided install to a USB stick or a VirtualBox/VMware virtual disk
Exec=pkexec /usr/local/bin/openbruma-install-removable
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
EOF

cp /usr/share/applications/openbruma-installer-guided.desktop /etc/skel/Desktop/
cp /usr/share/applications/openbruma-installer-custom.desktop /etc/skel/Desktop/
cp /usr/share/applications/openbruma-installer-removable.desktop /etc/skel/Desktop/
cp /usr/share/applications/openbruma-themes.desktop /etc/skel/Desktop/
cp /usr/share/applications/umbraforge.desktop /etc/skel/Desktop/WIC-UmbraForge.desktop 2>/dev/null || true
chmod +x /etc/skel/Desktop/*.desktop
ln -sfn /usr/share/backgrounds/openbruma /etc/skel/Desktop/Wallpapers

# The live user already exists, so its home was created before the desktop
# entries above. Mirror skel into it or the installers will not be visible.
if id openbruma >/dev/null 2>&1; then
  mkdir -p /home/openbruma/Desktop
  cp -a /etc/skel/Desktop/. /home/openbruma/Desktop/ 2>/dev/null || true
  chown -R openbruma:openbruma /home/openbruma/Desktop 2>/dev/null || true
fi

# Debian-style bootloader + display manager for Calamares. The stock Debian
# module configs assume Arch-style kernel names, which would install an
# unbootable system.
mkdir -p /etc/calamares/modules
cat > /etc/calamares/modules/bootloader.conf <<'EOF'
---
efiBootLoader: "grub"
kernel: "/vmlinuz"
img: "/initrd.img"
fallback: "/initrd.img"
timeout: 5
grubInstall: "grub-install"
grubMkconfig: "grub-mkconfig"
grubCfg: "/boot/grub/grub.cfg"
grubProbe: "grub-probe"
efiBootMgr: "efibootmgr"
installEFIFallback: true
EOF

cat > /etc/calamares/modules/displaymanager.conf <<'EOF'
---
displaymanagers:
  - lightdm
basicSetup: false
sysconfigSetup: false
EOF

cat > /etc/calamares/modules/users.conf <<'EOF'
---
userGroup: users
defaultGroups:
  - cdrom
  - floppy
  - sudo
  - audio
  - dip
  - video
  - plugdev
  - netdev
  - lpadmin
  - scanner
  - bluetooth
autologinGroup: autologin
sudoersGroup: sudo
setRootPassword: false
# The live account must not be reused for the installed system, otherwise the
# install cleanup (shellprocess@livecleanup) would delete the new user.
user:
  shell: /bin/bash
  forbidden_names: [ root, openbruma, debian, user ]
passwordRequirements:
  nonempty: true
  minLength: -1
  maxLength: -1
  libpwquality:
    - minlen=0
    - minclass=0
EOF

# Security: the live session account (password openbruma, passwordless sudo)
# must not survive into an installed system. Remove it during installation.
cat > /etc/calamares/modules/shellprocess-livecleanup.conf <<'EOF'---
dontChroot: false
timeout: 30
script:
  - "userdel -r openbruma >/dev/null 2>&1 || true"
  - "rm -f /etc/sudoers.d/openbruma"
  - "rm -f /etc/polkit-1/rules.d/49-openbruma-live.rules"
  - "rm -f /etc/lightdm/lightdm.conf.d/50-openbruma-autologin.conf"
EOF

if [ -f /etc/calamares/settings.conf ] && ! grep -q 'shellprocess@livecleanup' /etc/calamares/settings.conf; then
  awk '
    /^- exec:/ { inexec = 1 }
    /^- show:/ { inexec = 0 }
    { print }
    inexec && /^  - users$/ { print "  - shellprocess@livecleanup" }
  ' /etc/calamares/settings.conf > /etc/calamares/settings.conf.new \
    && mv /etc/calamares/settings.conf.new /etc/calamares/settings.conf
fi

# Ensure the default Calamares settings use OpenBruma branding
if [ -f /etc/calamares/settings.conf ]; then
  sed -i 's/^branding:.*/branding: openbruma/' /etc/calamares/settings.conf || true
fi

# Plymouth boot splash branding
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme -R openbruma >/dev/null 2>&1 || true
fi

# Refresh font cache for the OpenBruma fonts
fc-cache -f >/dev/null 2>&1 || true
# Whisker reads xfce-applications.menu, which does not merge applications-merged;
# inject the OSINT/OPSEC/WIC categories so they appear in the application menu.
if [ -f /usr/share/openbruma/patch-xfce-menu.py ]; then
  python3 /usr/share/openbruma/patch-xfce-menu.py || true
fi
# Refresh the icon cache so the branded Whisker icon resolves immediately
gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
chmod +x /usr/local/bin/openbruma-wic-app 2>/dev/null || true
chmod +x /usr/local/bin/openbruma-set-wallpaper 2>/dev/null || true

# Welcome script
cat > /usr/local/bin/openbruma-welcome <<'EOF'
#!/bin/sh
cat <<'WELCOME'
========================================
 OpenBruma OSINT Edition (WinterGateIC)
========================================
 Install options (desktop icons):
   • Install OpenBruma (Guided)  - erase disk
   • Install OpenBruma (Custom)  - manual partitioning
 Tools: nmap, wireshark, exiftool, binwalk,
 sleuthkit, forensics-all, hashcat, john,
 Firefox ESR, Thunderbird, LibreOffice.
 Live user: openbruma / openbruma
WELCOME
EOF
chmod +x /usr/local/bin/openbruma-welcome

# Ensure the live user's skel is applied on first boot by live-config
echo "OpenBruma live setup complete"

